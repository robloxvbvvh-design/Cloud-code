PORT=3000
# Почта (SMTP) — без неё код входа печатается в консоль сервера (режим разработки)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM="Коли <you@gmail.com>"
# Генерация видео (Google Veo через Gemini API). Без ключа — демо-режим.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
# Бесплатная генерация на своей видеокарте: адрес воркера (см. worker/README.md)
LOCAL_WORKER_URL=
# Без видеокарты: BACKEND=hf (бесплатный облачный GPU Hugging Face; нужен pip install gradio_client).
# HF_TOKEN — бесплатный токен аккаунта HF (не покупка): без него общий лимит быстро заканчивается.
BACKEND=
HF_TOKEN=
